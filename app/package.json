{
    "name": "uchat",
    "private": true,
    "version": "3.10.0",
    "type": "module",
    "license": "AGPL-3.0-or-later",
    "scripts": {
        "dev": "vite dev",
        "dev:api": "API_URL=http://api.localhost:3000 WS_URL=ws://api.localhost:3000 vite dev",
        "dev:apiv2": "API_URL=http://api.unii.dev/v2 WS_URL=ws://api.unii.dev/v2 vite dev",
        "dev:open": "vite dev --open --host",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync || echo ''",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && bunx tsc --noEmit && bunx prettier --check .",
        "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
        "typecheck": "bunx tsc --noEmit",
        "fmt": "bunx prettier --write ."
    },
    "devDependencies": {
        "@socketsecurity/bun-security-scanner": "^1.1.2",
        "@sveltejs/adapter-static": "^3.0.10",
        "@sveltejs/kit": "^2.70.1",
        "@sveltejs/vite-plugin-svelte": "7.3.0",
        "@types/node": "^26.1.2",
        "@types/tinycolor2": "^1.4.6",
        "moment": "^2.30.1",
        "prettier": "^3.9.6",
        "prettier-plugin-svelte": "^4.1.1",
        "sass-embedded": "^1.100.0",
        "svelte": "^5.56.7",
        "svelte-check": "^4.7.3",
        "svelte-render-scan": "^1.1.0",
        "typescript": "^6.0.2",
        "vite": "^8.1.5",
        "youtubei.js": "^17.2.0"
    },
    "dependencies": {
        "@lucide/svelte": "^1.25.0",
        "@sentry/svelte": "^10.73.0",
        "@twemoji/api": "^17.0.3",
        "html-to-image": "^1.11.13",
        "svelte-awesome-color-picker": "^4.1.3",
        "svelte-i18n": "^4.0.1",
        "tinycolor2": "^1.6.0"
    }
}